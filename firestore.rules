rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn()
        && hasUserDoc(request.auth.uid)
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    function isSafeSelfUserUpdate(userId) {
      return isOwner(userId)
        && changedKeys().hasOnly([
          'name',
          'username',
          'birthDate',
          'gender',
          'bio',
          'profilePhoto',
          'isPrivate'
        ]);
    }

    function isValidSuspensionState() {
      return (
        request.resource.data.suspensionType == 'none'
        && request.resource.data.isSuspended == false
        && request.resource.data.suspensionUntil == null
      ) || (
        request.resource.data.suspensionType == 'temporary'
        && request.resource.data.isSuspended == true
        && request.resource.data.suspensionUntil is timestamp
      ) || (
        request.resource.data.suspensionType == 'permanent'
        && request.resource.data.isSuspended == true
        && request.resource.data.suspensionUntil == null
      );
    }

    function isValidAdminUserModerationUpdate(userId) {
      return isAdmin()
        && changedKeys().hasOnly([
          'role',
          'isSuspended',
          'suspensionType',
          'suspensionUntil',
          'warningsCount',
          'strikesCount',
          'updatedAt',
          'updatedByAdminId'
        ])
        && request.resource.data.updatedByAdminId == request.auth.uid
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.warningsCount is int
        && request.resource.data.warningsCount >= 0
        && request.resource.data.strikesCount is int
        && request.resource.data.strikesCount >= 0
        && request.resource.data.updatedAt is timestamp
        && isValidSuspensionState()
        && (
          !changedKeys().hasAny(['role'])
          || request.auth.uid != userId
        );
    }

    function reportChangedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    function isValidReportStatusTransition() {
      return (
        resource.data.status == 'pending'
        && request.resource.data.status in ['reviewed', 'resolved', 'dismissed']
      ) || (
        resource.data.status in ['reviewed', 'resolved', 'dismissed']
        && request.resource.data.status == resource.data.status
      );
    }

    function isValidAdminReportReviewUpdate() {
      return isAdmin()
        && reportChangedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt',
          'resolutionNote'
        ])
        && isValidReportStatusTransition()
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.type == resource.data.type
        && request.resource.data.reportedId == resource.data.reportedId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.resolutionNote == null
          || (
            request.resource.data.resolutionNote is string
            && request.resource.data.resolutionNote.size() <= 2000
          )
        );
    }

    function isPublicPublishedPostData(postData) {
      return postData.status == 'published' && postData.privacy == 'public';
    }

    function isPublicPublishedPost(postId) {
      return exists(/databases/$(database)/documents/posts/$(postId))
        && isPublicPublishedPostData(
          get(/databases/$(database)/documents/posts/$(postId)).data
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isValidParticipantReactionUpdate(chatId) {
      return isChatParticipant(chatId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).changedKeys().hasOnly([request.auth.uid])
        && (
          !(request.auth.uid in request.resource.data.reactions.keys())
          || (
            request.resource.data.reactions[request.auth.uid] is string
            && request.resource.data.reactions[request.auth.uid].size() > 0
            && request.resource.data.reactions[request.auth.uid].size() <= 16
          )
        );
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isSuspended == false
        && request.resource.data.suspensionType == 'none'
        && request.resource.data.suspensionUntil == null
        && request.resource.data.warningsCount == 0
        && request.resource.data.strikesCount == 0;
      allow update: if isSafeSelfUserUpdate(userId) || isValidAdminUserModerationUpdate(userId);
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn()
        || isPublicPublishedPostData(resource.data);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      match /comments/{commentId} {
        allow read: if isSignedIn() || isPublicPublishedPost(postId);
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      match /likes/{likeId} {
        allow read: if isSignedIn() || isPublicPublishedPost(postId);
        allow create, delete: if request.auth != null
          && request.auth.uid == likeId;
      }
    }

    // Followers
    match /followers/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.followerId
            || request.auth.uid == resource.data.followingId);
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid
          || isValidParticipantReactionUpdate(chatId)
          || (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['deletedForUsers'])
            && request.resource.data.deletedForUsers.hasAll(resource.data.deletedForUsers)
            && request.resource.data.deletedForUsers.hasAny([request.auth.uid])
          )
        );
        allow delete: if isChatParticipant(chatId);
      }
    }

    // Feeds (fan-out on write)
    match /feeds/{userId} {
      match /user_feed/{feedItemId} {
        // Users can only read their own feed
        allow read: if request.auth != null
          && request.auth.uid == userId;
        // Only Cloud Functions (admin SDK) can write feed items
        allow write: if false;
      }
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.type in ['post', 'user', 'comment', 'message']
        && request.resource.data.reportedId is string
        && request.resource.data.reportedId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && (
          request.resource.data.description == null
          || (
            request.resource.data.description is string
            && request.resource.data.description.size() <= 2000
          )
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.resolutionNote == null
        && request.resource.data.createdAt is timestamp;
      allow read: if (request.auth != null
        && resource.data.reporterId == request.auth.uid)
        || isAdmin();
      allow update: if isValidAdminReportReviewUpdate();
      allow delete: if false;
    }

    // Moderation audit logs (append-only)
    match /moderation_audit_logs/{logId} {
      allow create: if false;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
